# Example environment variables for Shoppy-backEnd
# Copy this file to .env and fill in your own values

PORT=3000
MONGO_URL=mongodb://localhost:27017/shoppy
CORS_ORIGIN=http://localhost:3003
DEFAULT_PRODUCT_IMAGE_PATH=public/images/products/default.png
DEFAULT_USER_IMAGE_PATH=public/images/users/default.png
JWT_KEY=your_jwt_secret
SMTP_USERNAME=your_email_address
SMTP_PASSWORD=your_email_password
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
